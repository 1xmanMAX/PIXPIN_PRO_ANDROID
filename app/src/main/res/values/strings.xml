    <!-- Onboarding -->
    <string name="onboarding_title">Bienvenido a PixPin</string>
    <string name="onboarding_subtitle">Captura, anota y fija notas flotantes sobre cualquier app. Necesito estos permisos para funcionar:</string>
    <string name="perm_overlay_title">Mostrar sobre otras apps</string>
    <string name="perm_overlay_desc">Imprescindible: los pines y la bola flotante son ventanas sobre las demás apps.</string>
    <string name="perm_notif_title">Notificaciones</string>
    <string name="perm_notif_desc">Barra persistente con botones de Capturar y Pinear.</string>
    <string name="perm_battery_title">Excluir de ahorro de batería</string>
    <string name="perm_battery_desc">Evita que el sistema cierre PixPin y desaparezcan tus pines.</string>
