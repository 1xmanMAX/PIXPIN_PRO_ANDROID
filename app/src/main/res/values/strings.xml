    <!-- Modo de captura -->
    <string name="capture_mode_title">Modo de captura</string>
    <string name="capture_mode_fast">Rápido</string>
    <string name="capture_mode_fast_desc">Android pide permiso una vez y las siguientes capturas son instantáneas y fiables. Mientras dura, la sesión gasta como una grabación de pantalla y el sistema muestra su icono. Puedes cerrarla desde la notificación.</string>
    <string name="capture_mode_discreet">Discreto</string>
    <string name="capture_mode_discreet_desc">La sesión se cierra tras cada captura: sin icono permanente ni gasto de batería, pero Android pide permiso cada vez.</string>

    <!-- Informe de fallo -->
    <string name="crash_title">PixPin se cerró de forma inesperada</string>
    <string name="crash_desc">Hay un informe guardado con el detalle técnico del fallo. Mientras no lo descartes, PixPin no se activará sola al reiniciar el móvil.</string>
    <string name="safe_mode">Modo seguro: los pines guardados no se han restaurado. Descarta el informe de fallo para recuperarlos.</string>
    <string name="crash_share">Compartir informe</string>
    <string name="crash_dismiss">Descartar</string>

