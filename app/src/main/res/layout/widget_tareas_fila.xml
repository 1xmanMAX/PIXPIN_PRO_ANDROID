<?xml version="1.0" encoding="utf-8"?>
<!--
    Una tarea del widget: la casilla (tocarla la tacha; 44 dp de alto para el dedo) y el texto con
    su lista debajo (tocarlo abre la pantalla de Tareas). Un FrameLayout por fuera para el hueco
    entre tarjetas: el margen de la raíz de una fila no lo respeta la lista.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_fila"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_tarea_casilla"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:contentDescription="Marcar como hecha"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:scaleType="center"
            android:src="@drawable/widget_casilla" />

        <LinearLayout
            android:id="@+id/widget_tarea_cuerpo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/widget_tarea_texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/widget_tinta"
                android:textSize="14sp" />

            <!--
                El detalle, con delante (27-oct-2026) las dos personas en verde si la tarea es de un
                chat compartido y la inicial de quien la apuntó si no fui yo. Ocultos si no.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_tarea_compartida"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="3dp"
                    android:contentDescription="De un chat compartido"
                    android:src="@drawable/widget_compartida"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_tarea_autor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:textColor="@color/widget_verde_compartido"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_tarea_detalle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_tinta_suave"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
