<?xml version="1.0" encoding="utf-8"?>
<!--
    Una miniatura del widget de la galería, con su chapita de días abajo a la izquierda. Las
    esquinas se recortan con el contorno del fondo (Android 12 en adelante; antes salen rectas).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_galeria_celda"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:background="@drawable/widget_fila"
    android:clipToOutline="true"
    tools:targetApi="31">

    <ImageView
        android:id="@+id/widget_galeria_foto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/widget_galeria_chapita"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="4dp"
        android:background="@drawable/widget_chapita_lejos"
        android:maxLines="1"
        android:paddingStart="5dp"
        android:paddingTop="1dp"
        android:paddingEnd="5dp"
        android:paddingBottom="1dp"
        android:textColor="#FFE5E5EA"
        android:textSize="10sp"
        android:textStyle="bold" />
</FrameLayout>
