<?xml version="1.0" encoding="utf-8"?>
<!-- Lo que enseña el selector de widgets (Android 12+) del widget de tareas: un ejemplo quieto. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tareas"
            android:textColor="@color/widget_tinta"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="3"
            android:textColor="@color/widget_dorado"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:padding="2dp"
            android:src="@drawable/widget_mas" />
    </LinearLayout>

    <include layout="@layout/widget_tareas_vista_fila" />
    <include layout="@layout/widget_tareas_vista_fila" />
    <include layout="@layout/widget_tareas_vista_fila" />
</LinearLayout>
