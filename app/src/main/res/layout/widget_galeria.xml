<?xml version="1.0" encoding="utf-8"?>
<!--
    El widget de la galería (widget/WidgetDeGaleria.kt): cabecera con «Galería» y cuántas hay;
    debajo la rejilla de miniaturas, tantas columnas como quepan.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_galeria_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/widget_galeria_cabecera"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Galería"
            android:textColor="@color/widget_tinta"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_galeria_cuenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/widget_dorado"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <GridView
            android:id="@+id/widget_galeria_rejilla"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnWidth="72dp"
            android:horizontalSpacing="6dp"
            android:numColumns="auto_fit"
            android:scrollbars="none"
            android:stretchMode="columnWidth"
            android:verticalSpacing="6dp" />

        <TextView
            android:id="@+id/widget_galeria_vacio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="12dp"
            android:text="Aún no hay capturas. Toca para abrir la galería."
            android:textColor="@color/widget_tinta_suave"
            android:textSize="14sp" />
    </FrameLayout>
</LinearLayout>
