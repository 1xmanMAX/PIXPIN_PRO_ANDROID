    <string name="pdf_no_comprimir_desc">The PDF is saved as it arrives.</string>
    <string name="pdf_sin_perdida">Lossless</string>
    <string name="pdf_sin_perdida_desc">Not a pixel changes: it is only reorganized and packed inside. Gains little on scans, more on office documents.</string>
    <string name="pdf_equilibrado">Balanced</string>
    <string name="pdf_equilibrado_desc">Not noticeable to the eye: photos at 200 dpi, each one checked. A scan ends up around a quarter of the size.</string>
    <string name="pdf_pequeno">Small</string>
    <string name="pdf_pequeno_desc">For reading on screen: 150 dpi, and in scans the text is separated from the paper and stays sharp. Around a sixth of the size.</string>
    <string name="pdf_extremo">Extreme</string>
    <string name="pdf_extremo_desc">The minimum that still reads well: sharp text, paper and photos heavily simplified. Less than a tenth of the size on scans.</string>
