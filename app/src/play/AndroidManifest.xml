<?xml version="1.0" encoding="utf-8"?>
<!--
    **Lo que cambia en la versión de Google Play** (30-oct-2026). Se mezcla con el manifiesto de
    siempre; aquí solo se quita lo que Play no deja (ver docs/google-play.md):

    - REQUEST_INSTALL_PACKAGES: Play solo lo admite si instalar apps es la función principal
      (gestores de archivos, tiendas). Aquí era para abrir un APK recibido en el chat: en Play se
      comparte con otra app en vez de instalarlo (ver ui/AbrirCon.kt).
    - USE_FULL_SCREEN_INTENT: desde Android 14 Play solo lo da a apps de llamadas y despertadores. Sin
      él, la llamada secreta suena como una notificación urgente (Android la baja sola).
    - USE_EXACT_ALARM: solo para apps cuyo núcleo es un despertador o un calendario. En su lugar,
      SCHEDULE_EXACT_ALARM, que el usuario concede en Ajustes (y se le pide al poner un recordatorio).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" tools:node="remove" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
</manifest>
