# La configuración del servidor de PinDesk (lo que no es secreto de firma). Tras cambiarla: systemctl restart pindesk
# Los ID de cliente OAuth de Google que valen (el «web» que usa Android; el de escritorio de Windows), separados por comas.
GOOGLE_CLIENT_IDS=
# La galería de la comunidad: «si», lo nuevo espera a que lo apruebes en el panel; «no», se publica al momento.
GALERIA_REVISION=si
GALERIA_POR_DIA=10
# La clave de la API de Claude (console.anthropic.com). Solo vive aquí: la app nunca la ve.
CLAUDE_API_KEY=
# Los modelos que se pueden pedir (el primero es el que se usa si piden otro).
MODELOS_PERMITIDOS=claude-sonnet-5-5,claude-haiku-5-5
# Tope de respuesta por pregunta: con 24000 el asistente puede escribir una miniapp entera.
MAX_TOKENS=24000
# Preguntas al asistente por persona y día.
CUPO_GRATIS=15
CUPO_PRO=150
# Días de prueba de Pro para cada cuenta nueva.
DIAS_DE_PRUEBA=30
PUERTO=8080
HOST=127.0.0.1
